{
  "name": "packmate",
  "version": "2.2.0",
  "description": "Your smart and friendly assistant for dependency updates, security scanning, and cleanup with AI-powered caching, multi-source vulnerability detection, advanced TypeScript analysis, and team collaboration features.",
  "author": "AGUMON <ljlm0402@gmail.com>",
  "license": "MIT",
  "keywords": [
    "cli",
    "dependency",
    "update",
    "cleanup",
    "security",
    "vulnerability",
    "scanner", 
    "npm",
    "yarn",
    "pnpm",
    "dependency-manager",
    "remove-unused",
    "automation",
    "caching",
    "worker-pool",
    "predictive",
    "compression",
    "typescript-analysis",
    "team-collaboration",
    "policy-validation",
    "git-hooks",
    "config-analysis",
    "dynamic-imports",
    "tool",
    "nodejs"
  ],
  "type": "module",
  "main": "bin/packmate.js",
  "bin": {
    "packmate": "bin/packmate.js",
    "packmate-enhanced": "bin/packmate-enhanced.js"
  },
  "scripts": {
    "start": "node bin/packmate.js",
    "start:enhanced": "node bin/packmate-enhanced.js",
    "scan": "node bin/packmate-enhanced.js scan",
    "scan:deep": "node bin/packmate-enhanced.js scan --deep-scan",
    "analyze": "node bin/packmate-enhanced.js analyze", 
    "update": "node bin/packmate-enhanced.js update",
    "report": "node bin/packmate-enhanced.js report",
    "interactive": "node bin/packmate-enhanced.js interactive",
    "benchmark": "node scripts/benchmark.js",
    "test:performance": "node scripts/performance-test.js",
    "format": "prettier --write .",
    "lint": "eslint .",
    "build": "napi build --platform --release --manifest-path native/Cargo.toml",
    "build:debug": "napi build --platform --manifest-path native/Cargo.toml",
    "artifacts": "napi artifacts --manifest-path native/Cargo.toml"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.4.1",
    "cli-progress": "^3.12.0",
    "depcheck": "^1.4.7",
    "fs-extra": "^11.1.1",
    "globby": "^13.2.2",
    "js-yaml": "^4.1.0",
    "lodash": "^4.17.23",
    "p-map": "^7.0.3",
    "p-retry": "^6.2.1",
    "package-json": "^10.0.1",
    "precinct": "^10.0.0",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "eslint": "^9.27.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljlm0402/packmate.git"
  },
  "bugs": {
    "url": "https://github.com/ljlm0402/packmate/issues"
  },
  "homepage": "https://github.com/ljlm0402/packmate#readme"
}
